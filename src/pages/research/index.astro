---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const fmt = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}.${d.getUTCFullYear()}`;
---

<PageLayout
  title="Research"
  eyebrow="Akxar Labs"
  description="Our work on scenario design and oversight for multi-agent AI systems. Publications will appear here."
>
  {
    posts.length === 0 && (
      <div class="values-grid">
        <article class="value-card">
          <h3>Scenario design</h3>
          <p>Environments that probe cooperation, deception, and resource acquisition in agents.</p>
        </article>
        <article class="value-card">
          <h3>Oversight and monitoring</h3>
          <p>Tools for observing and steering multi-agent systems over long horizons.</p>
        </article>
        <article class="value-card">
          <h3>Publications</h3>
          <p>Coming soon.</p>
        </article>
      </div>
    )
  }
  <div class="research-grid">
    {
      posts.map((post) => (
        <a class="research-card" href={withBase(`/research/${post.id}`)}>
          <div class="research-card__cover">
            <img src={withBase(post.data.cover)} alt="" loading="lazy" />
          </div>
          <div class="research-card__meta">
            <span>{fmt(post.data.date)}</span>
            <span>{post.data.readTime}</span>
          </div>
          <h2>{post.data.headline}</h2>
          <p>{post.data.excerpt}</p>
          {post.data.tags.length > 0 && (
            <div class="research-card__tags">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </div>
</PageLayout>
