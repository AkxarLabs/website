---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HandsConnection from '../components/HandsConnection.astro';
import Footer from '../components/Footer.astro';
import { site, withBase } from '../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
---

<BaseLayout>
  <div class="site-shell">
    <SiteHeader />

    <main>
      <section class="hero" aria-labelledby="home-title">
        <HandsConnection />
        <div class="hero-copy">
          <p class="eyebrow">Collaborative AI safety lab</p>
          <h1 id="home-title">Safe AI, built <em>together</em>.</h1>
          <p class="hero-deck">
            Akxar Labs is an open, collaborative AI safety lab. We work in the open on alignment,
            evaluation, and human oversight — so the people building and using advanced AI stay
            meaningfully in control.
          </p>
          <div class="hero-actions">
            <a class="button button--dark" href={withBase('/research')}>Explore research -></a>
            <a class="button button--ghost" href="#collaborate">Collaborate with us</a>
          </div>
          <div class="scroll-cue" aria-hidden="true">
            <span></span>
            <span>Scroll to join the hands</span>
          </div>
        </div>
      </section>

      <div class="focus-row" aria-label="Research focus areas">
        <a class="focus-card" href={withBase('/research/tags/alignment')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path
              d="M12 36v-8c0-4 3-7 7-7h10c4 0 7 3 7 7v8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path>
            <circle cx="18" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="30" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
          </svg>
          <span><strong>Alignment</strong><span>Keeping capable systems pointed at human intent.</span></span
          >
          <span aria-hidden="true">-></span>
        </a>
        <a class="focus-card" href={withBase('/research/tags/reasoning')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path
              d="M24 8v13m0 0L13 34m11-13 11 13"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.7"></path>
            <circle cx="24" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="13" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="35" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
          </svg>
          <span
            ><strong>Evaluation</strong><span>Stress-testing reasoning, calibration, and failure modes.</span></span
          >
          <span aria-hidden="true">-></span>
        </a>
        <a class="focus-card" href={withBase('/research/tags/society')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="15" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <path
              d="M9 24h30M24 9c5 5 7 20 0 30M24 9c-5 5-7 20 0 30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path>
          </svg>
          <span><strong>Oversight</strong><span>Human control, governance, and public benefit.</span></span>
          <span aria-hidden="true">-></span>
        </a>
      </div>

      {
        featured && (
          <section class="featured-research" aria-labelledby="featured-title">
            <div class="featured-copy">
              <p class="kicker">Featured research</p>
              <h2 id="featured-title">{featured.data.headline}</h2>
              <p>{featured.data.excerpt}</p>
              <a class="text-link" href={withBase(`/research/${featured.id}`)}>
                Read the research
              </a>
            </div>
            <div class="research-visual" aria-hidden="true" />
          </section>
        )
      }

      <section class="section" id="collaborate" aria-labelledby="collaborate-title">
        <div class="section-header">
          <div>
            <p class="kicker">Collaborate</p>
            <h2 id="collaborate-title">Safety is a shared problem.</h2>
          </div>
          <p>
            We treat safety research as a commons: open problems, open methods, and open tools.
            There are several ways to work with us — whether you are a researcher, an engineer, or a
            lab looking for partners.
          </p>
        </div>
        <div class="values-grid">
          <article class="value-card">
            <h3>Open problems</h3>
            <p>
              A living list of concrete, tractable safety questions you can pick up — with data,
              baselines, and context to start fast.
            </p>
          </article>
          <article class="value-card">
            <h3>Visiting researchers</h3>
            <p>
              Short residencies and remote collaborations for students and researchers who want to
              co-author work and share results.
            </p>
          </article>
          <article class="value-card">
            <h3>Partner with us</h3>
            <p>
              Labs and teams can co-run evaluations, share infrastructure, and publish jointly under
              shared safety standards.
            </p>
          </article>
        </div>
        <div class="hero-actions" style="justify-content: flex-start; margin-top: 28px;">
          <a class="button button--dark" href={`mailto:${site.email}`}>Get involved -></a>
          <a class="button button--ghost" href={withBase('/research')}>See open work</a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
