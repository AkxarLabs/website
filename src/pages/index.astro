---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HandsConnection from '../components/HandsConnection.astro';
import Footer from '../components/Footer.astro';
import { site, withBase } from '../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 2);

const fmt = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}.${d.getUTCFullYear()}`;
---

<BaseLayout>
  <div class="site-shell">
    <SiteHeader />

    <main>
      <section class="hero" aria-labelledby="home-title">
        <HandsConnection />
        <div class="hero-copy">
          <p class="eyebrow">AI safety research</p>
          <h1 id="home-title">Studying AI agents, <em>together</em>.</h1>
          <p class="hero-deck">
            Akxar Labs is an early-stage research lab building open environments and oversight tools
            to study how AI agents behave, individually and in groups.
          </p>
          <div class="hero-actions">
            <a class="button button--dark" href={withBase('/research')}>Our research →</a>
            <a class="button button--ghost" href={`mailto:${site.email}`}>Get in touch</a>
          </div>
          <div class="scroll-cue" aria-hidden="true">
            <span></span>
            <span>Scroll</span>
          </div>
        </div>
      </section>

      <div class="focus-row" aria-label="Research focus areas">
        <a class="focus-card" href={withBase('/research')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path
              d="M12 36v-8c0-4 3-7 7-7h10c4 0 7 3 7 7v8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path>
            <circle cx="18" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="30" cy="15" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
          </svg>
          <span
            ><strong>Scenario design</strong><span
              >Environments that probe specific behavioral dispositions.</span
            ></span
          >
          <span aria-hidden="true">→</span>
        </a>
        <a class="focus-card" href={withBase('/research')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path
              d="M24 8v13m0 0L13 34m11-13 11 13"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.7"></path>
            <circle cx="24" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="13" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <circle cx="35" cy="34" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
          </svg>
          <span
            ><strong>Multi-agent oversight</strong><span
              >Monitoring and control for agent systems at scale.</span
            ></span
          >
          <span aria-hidden="true">→</span>
        </a>
        <a class="focus-card" href={withBase('/research')}>
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="15" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle>
            <path
              d="M9 24h30M24 9c5 5 7 20 0 30M24 9c-5 5-7 20 0 30"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path>
          </svg>
          <span
            ><strong>Open infrastructure</strong><span
              >Shared environments researchers can build on.</span
            ></span
          >
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        featuredPosts.length > 0 && (
          <section class="section featured-section" aria-labelledby="featured-title">
            <div class="section-header">
              <div>
                <p class="kicker">Featured research</p>
                <h2 id="featured-title">Our first releases.</h2>
              </div>
              <a class="text-link" href={withBase('/research')}>
                All research
              </a>
            </div>
            <div class="research-grid research-grid--featured">
              {featuredPosts.map((post) => (
                <a class="research-card" href={withBase(`/research/${post.id}`)}>
                  <div class="research-card__cover">
                    <img src={withBase(post.data.cover)} alt="" loading="lazy" />
                  </div>
                  <div class="research-card__meta">
                    <span>{fmt(post.data.date)}</span>
                    <span>{post.data.readTime}</span>
                  </div>
                  <h3>{post.data.headline}</h3>
                  <p>{post.data.excerpt}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class="section" id="research" aria-labelledby="directions-title">
        <div class="section-header">
          <div>
            <p class="kicker">Research directions</p>
            <h2 id="directions-title">Evaluating agents in open-ended settings.</h2>
          </div>
          <p>
            Open-ended multi-agent environments surface behavior that short, single-agent
            evaluations miss: long-horizon coordination, mutual influence, and unexpected
            strategies. We are building the tools to study it.
          </p>
        </div>
        <div class="values-grid">
          <article class="value-card">
            <h3>Scenario design</h3>
            <p>
              Scenarios that probe dispositions such as cooperation, deception, and resource
              acquisition, varied across agent count, model, and autonomy.
            </p>
          </article>
          <article class="value-card">
            <h3>Oversight and monitoring</h3>
            <p>
              Interfaces for observing and steering multi-agent simulations, and a testbed for
              comparing oversight and control mechanisms.
            </p>
          </article>
          <article class="value-card">
            <h3>Shared infrastructure</h3>
            <p>
              Common environments and monitoring tools that other researchers can use with their own
              questions and agents.
            </p>
          </article>
        </div>
        <div class="hero-actions" style="justify-content: flex-start; margin-top: 28px;">
          <a class="button button--dark" href={`mailto:${site.email}`}>Get in touch →</a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
