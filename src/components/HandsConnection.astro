<script>
  const scene = document.querySelector<HTMLElement>('[data-hands-scene]');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (scene) {
    // Scroll drives the "clasp": how far the two hands have closed the gap.
    const updateClasp = () => {
      const rect = scene.getBoundingClientRect();
      const viewport = window.innerHeight || 1;
      const raw = (viewport * 0.82 - rect.top) / (viewport * 0.85);
      const progress = Math.min(1, Math.max(0, raw));
      scene.style.setProperty('--clasp', progress.toFixed(3));
    };

    updateClasp();
    document.addEventListener('scroll', updateClasp, { passive: true });
    window.addEventListener('resize', updateClasp);

    // Pointer drives parallax depth. Each layer shifts in proportion to its
    // data-depth, and we lerp toward the target for a smooth, weighted feel.
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId = 0;

    const applyParallax = () => {
      currentX += (targetX - currentX) * 0.07;
      currentY += (targetY - currentY) * 0.07;
      scene.style.setProperty('--px', currentX.toFixed(4));
      scene.style.setProperty('--py', currentY.toFixed(4));
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth || '0.5');
        layer.style.setProperty('--lx', (currentX * depth).toFixed(4));
        layer.style.setProperty('--ly', (currentY * depth).toFixed(4));
      }
      if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
        rafId = requestAnimationFrame(applyParallax);
      } else {
        rafId = 0;
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      const rect = scene.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      targetX = Math.max(-1, Math.min(1, (event.clientX - cx) / (rect.width / 2 || 1)));
      targetY = Math.max(-1, Math.min(1, (event.clientY - cy) / (rect.height / 2 || 1)));
      if (!rafId) rafId = requestAnimationFrame(applyParallax);
    };

    const enableParallax = () => {
      if (reduceMotion.matches) return;
      window.addEventListener('pointermove', onPointerMove, { passive: true });
    };
    const disableParallax = () => {
      window.removeEventListener('pointermove', onPointerMove);
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(applyParallax);
    };

    enableParallax();
    reduceMotion.addEventListener('change', (event) => {
      if (event.matches) disableParallax();
      else enableParallax();
    });
  }
</script>
