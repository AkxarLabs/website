<script>
  const scene = document.querySelector<HTMLElement>('[data-hands-scene]');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (scene) {
    const smoothstep = (x: number) => x * x * (3 - 2 * x);

    // Scroll drives the clasp: hands rest apart at the top of the page and
    // join between 10vh and 60vh of scrolling — timed so the hero copy and
    // buttons have scrolled past the meeting point before the hands touch.
    // The scene itself tracks the scroll at a slower rate so the join stays
    // in view (scroll parallax).
    const hero = scene.closest<HTMLElement>('.hero');

    const updateScroll = () => {
      if (reduceMotion.matches) {
        scene.style.setProperty('--clasp', '1');
        scene.style.setProperty('--scroll-shift', '0px');
        hero?.style.setProperty('--clasp', '1');
        return;
      }
      const viewport = window.innerHeight || 1;
      const start = viewport * 0.1;
      const end = viewport * 0.65;
      const raw = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
      const clasp = smoothstep(raw).toFixed(3);
      scene.style.setProperty('--clasp', clasp);
      scene.style.setProperty('--scroll-shift', `${(window.scrollY * 0.44).toFixed(1)}px`);
      // The hero also carries --clasp so page-level elements (scroll cue)
      // can react to the join.
      hero?.style.setProperty('--clasp', clasp);
    };

    updateScroll();
    document.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll);

    // Pointer drives parallax depth. Each layer shifts in proportion to its
    // data-depth; we lerp toward the target so the motion feels weighted.
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId = 0;

    const applyParallax = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      scene.style.setProperty('--px', currentX.toFixed(4));
      scene.style.setProperty('--py', currentY.toFixed(4));
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth || '0.5');
        layer.style.setProperty('--lx', (currentX * depth).toFixed(4));
        layer.style.setProperty('--ly', (currentY * depth).toFixed(4));
      }
      if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
        rafId = requestAnimationFrame(applyParallax);
      } else {
        rafId = 0;
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      const rect = scene.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      targetX = Math.max(-1, Math.min(1, (event.clientX - cx) / (rect.width / 2 || 1)));
      targetY = Math.max(-1, Math.min(1, (event.clientY - cy) / (rect.height / 2 || 1)));
      if (!rafId) rafId = requestAnimationFrame(applyParallax);
    };

    const enableParallax = () => {
      if (reduceMotion.matches) return;
      window.addEventListener('pointermove', onPointerMove, { passive: true });
    };
    const disableParallax = () => {
      window.removeEventListener('pointermove', onPointerMove);
      targetX = 0;
      targetY = 0;
      if (!rafId) rafId = requestAnimationFrame(applyParallax);
    };

    enableParallax();
    reduceMotion.addEventListener('change', (event) => {
      updateScroll();
      if (event.matches) disableParallax();
      else enableParallax();
    });
  }
</script>
