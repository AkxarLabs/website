<script>
  const scene = document.querySelector<HTMLElement>('[data-hands-scene]');

  const updateHands = () => {
    if (!scene) return;
    const rect = scene.getBoundingClientRect();
    const viewport = window.innerHeight || 1;
    const raw = (viewport * 0.8 - rect.top) / (viewport * 0.85);
    const progress = Math.min(1, Math.max(0, raw));
    scene.style.setProperty('--clasp', progress.toFixed(3));
  };

  updateHands();
  document.addEventListener('scroll', updateHands, { passive: true });
  window.addEventListener('resize', updateHands);
</script>
