---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { withBase } from '../lib/site';

// Content revisions prevent a cached model from surviving a Pages deployment.
const asset = (path: string) => {
  const revision = createHash('sha256')
    .update(readFileSync(`public${path}`))
    .digest('hex')
    .slice(0, 10);
  return `${withBase(path)}?v=${revision}`;
};
---

<div class="hands-scene" data-hands-scene data-model={asset('/models/hands.glb')}>
  <div class="hands-depth">
    <picture class="hands-fallback">
      <source media="(max-width: 900px)" srcset={asset('/models/hands-poster-mobile.png')} />
      <img
        src={asset('/models/hands-poster-desktop.png')}
        width="1440"
        height="720"
        alt="Folded origami hands reaching toward each other beneath the headline"
        decoding="async"
      />
    </picture>
    <div
      class="hands-webgl"
      data-hands-webgl
      aria-hidden="true"
      role="img"
      aria-label="Three-dimensional origami hands made from folded paper panels, moving diagonally together until their fingertips touch"
    >
    </div>
  </div>
</div>

<script>
  const scene = document.querySelector<HTMLElement>('[data-hands-scene]');
  if (scene) {
    const load = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        load.disconnect();
        import('../lib/hands-scene')
          .then(({ mountHandsScene }) => mountHandsScene(scene))
          .catch(() => {});
      },
      { rootMargin: '240px' },
    );
    load.observe(scene);
  }
</script>
