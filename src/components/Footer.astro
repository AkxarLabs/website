---
import { navItems, site, withBase } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <div class="site-footer__brand">{site.name}</div>
      <p class="site-footer__note">
        An early-stage research lab studying how AI agents behave, and how to oversee them.
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      {navItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      <a href={`mailto:${site.email}`}>Contact</a>
    </nav>
    <div class="site-footer__meta">
      © {year}
      {site.name}
    </div>
  </div>
</footer>
